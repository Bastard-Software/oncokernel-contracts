{
  "$defs": {
    "CaveatCode": {
      "description": "Machine-readable limitations. Consumers are expected to render these.",
      "enum": [
        "TUMOR_ONLY_GERMLINE_UNSEPARATED",
        "PURITY_FIT_DEGRADED",
        "RESOURCES_UNVALIDATED",
        "NOT_GENOME_WIDE",
        "TERRITORY_PARTIALLY_EXCLUDED",
        "ORACLES_BYPASSED",
        "ORACLES_FAILED",
        "GENE_ANNOTATION_UNAVAILABLE"
      ],
      "title": "CaveatCode",
      "type": "string"
    },
    "GeneModel": {
      "additionalProperties": false,
      "description": "The catalogue release that minted a profile's transcript ids.\n\nA bare transcript id is not a coordinate. `ENST00000646891` is `.1` in\nEnsembl 103 and `.2` in Ensembl 115, and PAVE emits them unversioned, so a\nconsumer resolving transcript to protein to residue without the release\nsilently uses whichever one it happens to hold. That failure draws the wrong\nresidue and looks entirely plausible doing it.\n\n`annotator` is the tool that assigned the transcripts, not the tool that\ncalled the variants: two runs of the same caller against different PAVE\nversions can disagree about which transcript is canonical.",
      "properties": {
        "annotator": {
          "description": "tool that assigned the transcripts, e.g. 'pave@1.9'",
          "minLength": 1,
          "title": "Annotator",
          "type": "string"
        },
        "assembly": {
          "description": "e.g. 'GRCh38'",
          "minLength": 1,
          "title": "Assembly",
          "type": "string"
        },
        "release": {
          "description": "catalogue release, e.g. '110'",
          "minLength": 1,
          "title": "Release",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/GeneModelSource"
        }
      },
      "required": [
        "source",
        "release",
        "assembly",
        "annotator"
      ],
      "title": "GeneModel",
      "type": "object"
    },
    "GeneModelSource": {
      "description": "Which catalogue assigned a variant's transcript ids.\n\nEnsembl and RefSeq number transcripts independently, so `ENST...` and `NM_...`\nare not two spellings of one coordinate \u2014 a residue position resolved against\nthe wrong catalogue is wrong without looking wrong.",
      "enum": [
        "ensembl",
        "refseq"
      ],
      "title": "GeneModelSource",
      "type": "string"
    },
    "Limitation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/CaveatCode"
        },
        "rendering": {
          "title": "Rendering",
          "type": "string"
        }
      },
      "required": [
        "code",
        "rendering"
      ],
      "title": "Limitation",
      "type": "object"
    },
    "MsiStatus": {
      "enum": [
        "MSI",
        "MSS"
      ],
      "title": "MsiStatus",
      "type": "string"
    },
    "Panel": {
      "description": "Registered panels.\n\nMembers are **assay-versioned** on purpose: revisions change footprint, and a\nTMB validated against last year's territory is not validated against this\nyear's.\n\nSeeded with two publicly documented assays so the mechanism has real test\ncoverage on both sides of the floor. **The footprint figures below are taken\nfrom public documentation and require clinical sign-off before any\nproduction use** \u2014 see `docs/panels.md`.",
      "enum": [
        "foundation_one_cdx_v1",
        "msk_impact_v468"
      ],
      "title": "Panel",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "container_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Container Digests",
          "type": "object"
        },
        "engine": {
          "description": "e.g. 'sage-minimal' or 'oncoanalyser@2.3.0'",
          "title": "Engine",
          "type": "string"
        },
        "gene_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pipeline_git_sha": {
          "title": "Pipeline Git Sha",
          "type": "string"
        },
        "resource_bundle": {
          "description": "e.g. 'public-unvalidated@<manifest-hash>' or 'hmf@<version>'",
          "title": "Resource Bundle",
          "type": "string"
        },
        "tool_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tool Versions",
          "type": "object"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus"
        }
      },
      "required": [
        "engine",
        "resource_bundle",
        "validation_status",
        "pipeline_git_sha"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RegionsAnalysed": {
      "additionalProperties": false,
      "description": "The genomic territory an analysis actually covered.\n\nTogether with `SampleMode` this decides which metrics a profile is entitled\nto carry. Purity, ploidy and MSI require genome-wide coverage. TMB is\nadditionally allowed from a large enough registered panel \u2014 but only on the\ntumor/normal track (see `supports_tmb`).",
      "properties": {
        "analysed_bases": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysed Bases"
        },
        "excluded": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Excluded",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/Territory"
        },
        "panel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Panel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "regions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "RegionsAnalysed",
      "type": "object"
    },
    "SampleMode": {
      "description": "The clinical track a profile was produced on.\n\n`TUMOR_NORMAL` is the baseline. `TUMOR_ONLY` is a supported but structurally\ncompromised fallback \u2014 it triggers stricter rules elsewhere in this library.",
      "enum": [
        "tumor_normal",
        "tumor_only"
      ],
      "title": "SampleMode",
      "type": "string"
    },
    "Territory": {
      "description": "What genomic territory the analysis actually covered.",
      "enum": [
        "genome_wide",
        "panel",
        "subset"
      ],
      "title": "Territory",
      "type": "string"
    },
    "TmbMethod": {
      "description": "How a TMB value was derived. Never let these two be compared to one another.",
      "enum": [
        "genome_wide",
        "panel_derived"
      ],
      "title": "TmbMethod",
      "type": "string"
    },
    "ValidationStatus": {
      "description": "Whether the run used licensed reference resources or public substitutes.",
      "enum": [
        "unvalidated_resources",
        "validated"
      ],
      "title": "ValidationStatus",
      "type": "string"
    },
    "Variant": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "minLength": 1,
          "title": "Alt",
          "type": "string"
        },
        "chrom": {
          "title": "Chrom",
          "type": "string"
        },
        "consequence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. missense_variant, splice_acceptor_variant&intron_variant",
          "title": "Consequence"
        },
        "filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "VCF FILTER, e.g. PASS",
          "title": "Filter"
        },
        "gene": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene"
        },
        "hgvs_coding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HGVS c., e.g. c.1799T>A",
          "title": "Hgvs Coding"
        },
        "hgvs_protein": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HGVS p., e.g. p.Val600Glu",
          "title": "Hgvs Protein"
        },
        "pos": {
          "description": "1-based, VCF convention",
          "exclusiveMinimum": 0,
          "title": "Pos",
          "type": "integer"
        },
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "caller tier, e.g. SAGE HOTSPOT",
          "title": "Tier"
        },
        "transcript": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ensembl transcript id, e.g. ENST00000646891",
          "title": "Transcript"
        },
        "vaf": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vaf"
        }
      },
      "required": [
        "chrom",
        "pos",
        "ref",
        "alt"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The egress projection \u2014 the only payload that crosses the moat.\n\nBuilt exclusively via `projection.project()`, which is what guarantees every\nsource field was explicitly mapped or explicitly dropped.",
  "properties": {
    "hla_type": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Hla Type",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Limitation"
      },
      "title": "Limitations",
      "type": "array"
    },
    "msi_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/MsiStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ploidy": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ploidy"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "regions_analysed": {
      "$ref": "#/$defs/RegionsAnalysed"
    },
    "sample_mode": {
      "$ref": "#/$defs/SampleMode"
    },
    "sample_uuid": {
      "format": "uuid",
      "title": "Sample Uuid",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "somatic_variants": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Variant"
      },
      "title": "Somatic Variants",
      "type": "array"
    },
    "tmb": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tmb"
    },
    "tmb_method": {
      "anyOf": [
        {
          "$ref": "#/$defs/TmbMethod"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tumor_purity": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tumor Purity"
    }
  },
  "required": [
    "sample_mode",
    "regions_analysed",
    "provenance",
    "sample_uuid"
  ],
  "title": "PseudonymizedProfile",
  "type": "object"
}
