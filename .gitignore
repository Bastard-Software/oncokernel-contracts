# Personal Claude Code settings. Only `settings.local.json` — a shared
# `.claude/settings.json` is fine to commit. Pinned here rather than relying on a
# per-developer global ignore, which a new clone would not have.
.claude/settings.local.json

# Secrets. This library reads no environment variables by design, but a stray
# .env should never be committable.
.env
*.env

